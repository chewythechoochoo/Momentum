# Copy to .env for local runs. NEVER commit .env.
# All keys are PAPER-trading only. Live keys will be REFUSED at startup.

# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your_paper_secret_here

# Hard switch — must remain "true". Set to anything else and the bot exits.
ALPACA_PAPER=true

# Optional: explicit endpoint override (default paper endpoint is used if blank).
# Setting this to a live URL will be refused by safety.py.
ALPACA_BASE_URL=

# Optional: NewsAPI.org free tier as a tertiary fallback (Alpaca news is primary).
NEWSAPI_KEY=

# Bot behavior
MIN_RUN_INTERVAL_MINUTES=14
TRADING_ENABLED=true
LOG_LEVEL=INFO
